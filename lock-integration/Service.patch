+  function readVoiceStatus() {
+    try { root.voiceStatus = JSON.parse(voiceStatusFile.text() || "{}") } catch (e) { root.voiceStatus = ({}) }
+  }
+
+  function voiceUnlockWith(token) {
+    if (!root.lockRequested && !root.currentlyLocked()) return "not-locked"
+    if (!token || String(token).length < 16) return "denied"
+    voiceTokenFile.reload()
+    var parts = String(voiceTokenFile.text() || "").trim().split(/\s+/)
+    voiceTokenClear.running = true
+    if (parts.length < 2 || parts[0] !== String(token)) { root.logEvent("voice-unlock-denied"); return "denied" }
+    if (Number(parts[1]) < Date.now()) { root.logEvent("voice-unlock-expired"); return "expired" }
+    root.logEvent("voice-unlocked")
+    root.finishUnlock()
+    return "ok"
+  }
